<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Legendary.Companion</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Compile the pure (non-Blazor) logic directly so tests don't depend on the WASM app. -->
  <ItemGroup>
    <Compile Include="../src/Models/**/*.cs" />
    <Compile Include="../src/Data/SetJson.cs" />
    <Compile Include="../src/Data/KeywordJson.cs" />
    <Compile Include="../src/Services/CardPool.cs" />
    <Compile Include="../src/Services/SetupRandomizer.cs" />
  </ItemGroup>

  <!-- The tests validate the real content JSON. -->
  <ItemGroup>
    <None Include="../src/wwwroot/data/sets.json" CopyToOutputDirectory="PreserveNewest" LinkBase="data" />
    <None Include="../src/wwwroot/data/keywords.json" CopyToOutputDirectory="PreserveNewest" LinkBase="data" />
    <None Include="../src/wwwroot/data/card-keywords.json" CopyToOutputDirectory="PreserveNewest" LinkBase="data" />
  </ItemGroup>

</Project>
