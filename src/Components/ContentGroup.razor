@* One labelled sub-list inside a set's expanded contents (e.g. "Heroes (15)"). *@

<div class="set-group">
    <h4 class="set-group__title">
        @Title <span class="set-group__count">@Count</span>
    </h4>
    <ul class="tag-list">
        @ChildContent
    </ul>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public int Count { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
