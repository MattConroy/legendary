@* Threat band pill (Easy/Medium/Hard): the Mastermind's anchor level on the Home
   page and Cards browser, and a Scheme's ± modifier. Single element — the scoped
   styles target the tag and vary by the data-band attribute. *@

<span data-band="@Band.ToString().ToLowerInvariant()" title="@Title">@Band</span>

@code {
    [Parameter, EditorRequired] public DifficultyBand Band { get; set; }

    /// <summary>Optional hover text explaining what the band means in context.</summary>
    [Parameter] public string? Title { get; set; }
}
