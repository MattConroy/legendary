@* A small pill showing a threat band (Easy/Medium/Hard): the Mastermind's anchor
   level on the Home page and the Cards browser, and a Scheme's ± modifier. *@

<span class="tpill tpill--@Band.ToString().ToLowerInvariant()" title="@Title">
    <span class="tpill__value">@Band</span>
</span>

@code {
    [Parameter, EditorRequired] public DifficultyBand Band { get; set; }

    /// <summary>Optional hover text explaining what the band means in context.</summary>
    [Parameter] public string? Title { get; set; }
}
