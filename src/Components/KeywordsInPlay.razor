@* The "Keywords in play" card shown under a rolled setup: the glossary entries
   for every keyword appearing on the drawn cards. Reuses ResultCard's chrome. *@

@if (Keywords.Count > 0)
{
    <ResultCard Title="Keywords in play" Icon="📖" Accent="notes">
        <SubtitleContent>@Keywords.Count in this setup · <a href="keywords">glossary</a></SubtitleContent>
        <ChildContent>
            <ul class="list">
                @foreach (var keyword in Keywords)
                {
                    <li>
                        <span class="name">@keyword.Name</span>
                        <span class="def">@keyword.Summary</span>
                    </li>
                }
            </ul>
        </ChildContent>
    </ResultCard>
}

@code {
    [Parameter] public IReadOnlyList<Keyword> Keywords { get; set; } = [];
}
