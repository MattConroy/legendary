@* Renders a hero's team badge from wwwroot/teams/<slug>.{png,svg}. Most badges are
   card-accurate faction icons (PNG); a couple with no card icon fall back to our
   original glyph designs (SVG). *@

<img class="team-icon" src="@Src" alt="@Label" title="@Label" loading="lazy" />

@code {
    [Parameter] public string? Team { get; set; }

    private string Label => string.IsNullOrWhiteSpace(Team) ? "Unaffiliated" : Team!;

    // Teams without a card-accurate PNG keep their original SVG glyph.
    private static readonly HashSet<string> SvgSlugs = new() { "guardians-of-the-multiverse", "unaffiliated" };

    private string Src => $"teams/{Slug}.{(SvgSlugs.Contains(Slug) ? "svg" : "png")}";

    private string Slug => Team switch
    {
        "Avengers" => "avengers",
        "Fantastic Four" => "fantastic-four",
        "Guardians of the Galaxy" => "guardians-of-the-galaxy",
        "X-Men" => "x-men",
        "X-Force" => "x-force",
        "Marvel Knights" => "marvel-knights",
        "S.H.I.E.L.D." => "shield",
        "Spider-Friends" => "spider-friends",
        "Sinister Six" => "sinister-six",
        "Brotherhood" => "brotherhood",
        "Foes of Asgard" => "foes-of-asgard",
        "Crime Syndicate" => "crime-syndicate",
        "Illuminati" => "illuminati",
        "Cabal" => "cabal",
        "HYDRA" => "hydra",
        "New Warriors" => "new-warriors",
        "Mercs for Money" => "mercs-for-money",
        "Champions" => "champions",
        "Warbound" => "warbound",
        "Venomverse" => "venomverse",
        "Heroes of Asgard" => "heroes-of-asgard",
        "Inhumans" => "inhumans",
        "X-Factor" => "x-factor",
        "Heroes of Wakanda" => "heroes-of-wakanda",
        "Guardians of the Multiverse" => "guardians-of-the-multiverse",
        _ => "unaffiliated",
    };
}
