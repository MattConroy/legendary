@* Renders a hero's team badge from wwwroot/teams/<slug>.svg. The badges are our
   own colour-coded designs (canonical team colours, original glyph shapes). *@

<img class="team-icon" src="@Src" alt="@Label" title="@Label" loading="lazy" />

@code {
    [Parameter] public string? Team { get; set; }

    private string Label => string.IsNullOrWhiteSpace(Team) ? "Unaffiliated" : Team!;

    private string Src => $"teams/{Slug}.svg";

    private string Slug => Team switch
    {
        "Avengers" => "avengers",
        "X-Men" => "x-men",
        "X-Force" => "x-force",
        "Marvel Knights" => "marvel-knights",
        "S.H.I.E.L.D." => "shield",
        "Spider-Friends" => "spider-friends",
        _ => "unaffiliated",
    };
}
