@* The expanded per-hero deck breakdown: one row per card (class icons, copies,
   name, attack/recruit value, cost), an original mechanic note, and keyword chips. *@

<ul class="deck">
    @foreach (var d in Deck)
    {
        <li>
            <div class="row">
                <span class="classes">
                    @foreach (var heroClass in d.Classes)
                    {
                        <img src="classes/@(heroClass.ToLowerInvariant()).png" alt="@heroClass" title="@heroClass" />
                    }
                </span>
                <span class="copies">@d.Copies×</span>
                <span class="name">@d.Name</span>
                @if (d.Kind is not null && d.Value is not null)
                {
                    <span class="stat" data-kind="@d.Kind" title="@ValText(d) @Resource(d.Kind)">
                        <img src="classes/@(d.Kind).svg" alt="@Resource(d.Kind)" />
                        <span>@ValText(d)</span>
                    </span>
                }
                @if (d.Cost is { } cost)
                {
                    <span class="cost" title="Cost @cost">
                        <img src="classes/cost.svg" alt="Cost" />
                        <span>@cost</span>
                    </span>
                }
            </div>
            @if (!string.IsNullOrEmpty(d.Effect))
            {
                <p class="effect">@EffectHtml(d.Effect)</p>
            }
            <KeywordChips Class="deck-keywords" Items="d.Keywords.Select(kw => (kw, KwBase(kw), (string?)null))" />
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CardDetail> Deck { get; set; } = [];

    private static string Resource(string kind) => kind == "recruit" ? "Recruit" : "Attack";

    private static string ValText(CardDetail d) => $"{d.Value}{(d.Variable ? "+" : "")}";

    // A card's keyword token can carry a value (e.g. "Focus 3"); link to the base
    // keyword ("Focus") so the glossary search finds it.
    private static string KwBase(string keyword) =>
        System.Text.RegularExpressions.Regex.Replace(keyword, @"\s+\d+$", "");

    // Effect notes carry explicit {slug} tokens for icons (e.g. "{avengers}", "+3 {attack}").
    // Only those tokens are swapped for icons; signed numbers are bolded.
    private static readonly System.Text.RegularExpressions.Regex TokenRe = new(@"\{([a-z0-9-]+)\}");
    private static readonly System.Text.RegularExpressions.Regex NumRe = new(@"([+\-]\d+)");
    private static readonly HashSet<string> ResourceSlugs = new() { "attack", "recruit", "cost" };
    private static readonly HashSet<string> ClassSlugs = new() { "covert", "instinct", "ranged", "strength", "tech" };

    private static MarkupString EffectHtml(string s)
    {
        var html = new System.Text.StringBuilder();
        var last = 0;
        foreach (System.Text.RegularExpressions.Match m in TokenRe.Matches(s))
        {
            if (m.Index > last) html.Append(Boldify(s[last..m.Index]));
            var slug = m.Groups[1].Value;
            var src = ResourceSlugs.Contains(slug) ? $"classes/{slug}.svg"
                : ClassSlugs.Contains(slug) ? $"classes/{slug}.png"
                : $"teams/{slug}.png";
            html.Append($"<img class=\"effect-icon\" src=\"{src}\" alt=\"{slug}\" />");
            last = m.Index + m.Length;
        }
        if (last < s.Length) html.Append(Boldify(s[last..]));
        return new MarkupString(html.ToString());
    }

    // Encode text, bold signed numbers (+4, -2) so bonuses stand out, and turn the
    // card's own line breaks (\n) into <br> so multi-effect cards read line by line
    // just like the printed card.
    private static string Boldify(string t) =>
        NumRe.Replace(System.Net.WebUtility.HtmlEncode(t), "<strong>$1</strong>")
             .Replace("\n", "<br>");
}
