@* One row in the card browser: a clickable header (team badge, name, set, threat
   pill) that expands to show the card's deck breakdown and keywords-in-play. *@

<li class="card-entry @(Open && Deck.Count > 0 ? "card-entry--open" : "")">
    <div class="@HeadClass" role="@RoleAttr" tabindex="@TabAttr" aria-expanded="@ExpandedAttr"
         @onclick="Toggle" @onkeydown="OnKey">
        @if (Deck.Count > 0)
        {
            <span class="card-entry__caret @(Open ? "card-entry__caret--open" : "")" aria-hidden="true">▸</span>
        }
        <div class="card-entry__main">
            @if (Card is Hero hero)
            {
                <TeamIcon Team="@hero.Team" />
            }
            <span class="card-entry__name">@Card.Name</span>
            <span class="card-entry__set">@SetName</span>
            @if (Band is { } b)
            {
                <ThreatPill Band="b" />
            }
        </div>
    </div>
    @if (Open && Deck.Count > 0)
    {
        <CardDeck Deck="Deck" />
    }
    <KeywordChips Class="card-entry__keywords" Items="Kws.Select(k => (k.Name, k.Name, (string?)k.Summary))" />
</li>

@code {
    [Parameter, EditorRequired] public GameCard Card { get; set; } = default!;
    [Parameter] public string SetName { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<CardDetail> Deck { get; set; } = [];
    [Parameter] public IReadOnlyList<Keyword> Kws { get; set; } = [];
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }

    private bool Clickable => Deck.Count > 0;
    private string HeadClass => Clickable ? "card-entry__head is-clickable" : "card-entry__head";
    private string? RoleAttr => Clickable ? "button" : null;
    private string? TabAttr => Clickable ? "0" : null;
    private bool? ExpandedAttr => Clickable ? Open : null;
    private DifficultyBand? Band => (Card as Mastermind)?.ThreatBand ?? (Card as Scheme)?.ThreatBand;

    private Task Toggle() => Clickable ? OnToggle.InvokeAsync() : Task.CompletedTask;

    private Task OnKey(KeyboardEventArgs e) =>
        Clickable && e.Key is "Enter" or " " ? OnToggle.InvokeAsync() : Task.CompletedTask;
}
