@* One set in the Settings list: a header row (an expand caret, the set name — which
   deep-links to this set on the Cards page — the year, a Standalone pill, and the
   Own/Play toggles) that expands to show the set's contents inline. *@

<li class="set @(Owned ? "" : "unowned") @(Open ? "open" : "")">
    <div class="row">
        <div class="header">
            <button type="button" class="caret" @onclick="OnToggle"
                    aria-expanded="@Open" aria-label="@(Open ? "Hide" : "Show") contents of @Set.Name">▸</button>
            <a class="name" href="@CardLink.ToSet(Set.Id)" title="Browse @Set.Name on the Cards page">@Set.Name</a>
            <span class="date">@Set.Released.Year</span>
            @if (Set.Standalone)
            {
                <span class="pill" title="Can be played on its own">Standalone</span>
            }
        </div>

        <label class="switch" title="@(Owned ? "Owned" : "Not owned")">
            <input type="checkbox" checked="@Owned" @onchange="e => OnOwnChanged.InvokeAsync(e.Value is true)" />
            <span class="track"><span class="thumb"></span></span>
        </label>
        <label class="switch" title="In play this game">
            <input type="checkbox" checked="@Enabled" @onchange="e => OnPlayChanged.InvokeAsync(e.Value is true)" />
            <span class="track"><span class="thumb"></span></span>
        </label>
    </div>

    @if (Open)
    {
        <div class="contents">
            @if (Set.Masterminds.Count > 0)
            {
                <ContentGroup Title="Masterminds" Count="Set.Masterminds.Count">
                    @foreach (var c in Set.Masterminds) { <li><a class="tag" href="@CardLink.To(c)">@c.Name</a></li> }
                </ContentGroup>
            }
            @if (Set.Schemes.Count > 0)
            {
                <ContentGroup Title="Schemes" Count="Set.Schemes.Count">
                    @foreach (var c in Set.Schemes) { <li><a class="tag" href="@CardLink.To(c)">@c.Name</a></li> }
                </ContentGroup>
            }
            @if (Set.VillainGroups.Count > 0)
            {
                <ContentGroup Title="Villain Groups" Count="Set.VillainGroups.Count">
                    @foreach (var c in Set.VillainGroups) { <li><a class="tag" href="@CardLink.To(c)">@c.Name</a></li> }
                </ContentGroup>
            }
            @if (Set.Henchmen.Count > 0)
            {
                <ContentGroup Title="Henchmen" Count="Set.Henchmen.Count">
                    @foreach (var c in Set.Henchmen) { <li><a class="tag" href="@CardLink.To(c)">@c.Name</a></li> }
                </ContentGroup>
            }
            @if (Set.Heroes.Count > 0)
            {
                <ContentGroup Title="Heroes" Count="Set.Heroes.Count">
                    @foreach (var c in Set.Heroes)
                    {
                        <li><a class="tag tag--hero" href="@CardLink.To(c)"><TeamIcon Team="@c.Team" />@c.Name</a></li>
                    }
                </ContentGroup>
            }
        </div>
    }
</li>

@code {
    [Parameter, EditorRequired] public CardSet Set { get; set; } = default!;
    [Parameter] public bool Owned { get; set; }
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback<bool> OnOwnChanged { get; set; }
    [Parameter] public EventCallback<bool> OnPlayChanged { get; set; }
}
