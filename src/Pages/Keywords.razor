@page "/keywords"
@inject GameStateService State
@inject IKeywordRepository Catalog
@inject NavigationManager Nav

<PageTitle>Legendary — Keywords</PageTitle>

<div class="keywords">
    <h1 class="page-title">Keywords</h1>
    <p class="muted small">Ability keywords from every expansion, with their rulebook definitions — so you don't have to leaf through the books.</p>

    @if (_loadFailed)
    {
        <Notice>Couldn't load the keyword glossary. Check your connection and reload.</Notice>
    }
    else if (!Catalog.IsLoaded)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        <FilterBar Search="@_search" SearchChanged="SetSearch"
                   SetFilter="@_setFilter" SetFilterChanged="SetSetFilter"
                   Sets="SetsWithKeywords.Select(s => (s.Id, s.Name))"
                   AllLabel="All expansions" SearchPlaceholder="Search keywords…"
                   SearchLabel="Search keywords" FilterLabel="Filter by expansion" />

        var results = Filtered().ToList();
        <p class="muted small result-count">@results.Count keyword@(results.Count == 1 ? "" : "s")</p>

        @if (results.Count == 0)
        {
            <p class="muted">No keywords match.</p>
        }
        else
        {
            <ul class="list">
                @foreach (var k in results)
                {
                    <li class="item">
                        <div class="name">@k.Name</div>
                        <div class="def">@k.Summary</div>
                        @if (k.HasFullRules)
                        {
                            <details class="rules">
                                <summary>Full rules</summary>
                                <ul class="rules-list">
                                    @foreach (var line in k.Rules)
                                    {
                                        <li>@line</li>
                                    }
                                </ul>
                            </details>
                        }
                        <ul class="tag-list sets">
                            @foreach (var sid in k.Sets.OrderBy(SetOrder))
                            {
                                <li class="tag set">@SetName(sid)</li>
                            }
                        </ul>
                    </li>
                }
            </ul>
        }
    }
</div>

@code {
    private string _search = string.Empty;
    private string _setFilter = string.Empty;

    private Dictionary<string, string> _names = new();
    private Dictionary<string, int> _order = new();

    private bool _loadFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await State.InitializeAsync();       // loads the set catalogue (names/order)
            await Catalog.EnsureLoadedAsync();   // loads the keyword glossary
            var ordered = State.AllSets.OrderBy(s => s.Released).ThenBy(s => s.Name).ToList();
            _names = ordered.ToDictionary(s => s.Id, s => s.Name);
            _order = ordered.Select((s, i) => (s.Id, i)).ToDictionary(t => t.Id, t => t.i);

            // Auto-populate from the URL (e.g. arriving from a keyword chip on the
            // Cards page: keywords?search=Focus).
            var query = ParseQuery(Nav.Uri);
            if (query.TryGetValue("search", out var search)) _search = search;
            if (query.TryGetValue("set", out var set)) _setFilter = set;
        }
        catch
        {
            _loadFailed = true;
        }
    }

    private void SetSearch(string value) { _search = value; SyncUrl(); }
    private void SetSetFilter(string value) { _setFilter = value; SyncUrl(); }

    // Keep the URL in step with the controls so back-navigation returns here intact.
    private void SyncUrl()
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["search"] = string.IsNullOrEmpty(_search) ? null : _search,
            ["set"] = string.IsNullOrEmpty(_setFilter) ? null : _setFilter,
        });
        Nav.NavigateTo(uri, forceLoad: false, replace: true);
    }

    private static Dictionary<string, string> ParseQuery(string uri)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var i = uri.IndexOf('?');
        if (i < 0) return result;
        foreach (var pair in uri[(i + 1)..].Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split('=', 2);
            result[Uri.UnescapeDataString(kv[0])] = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : string.Empty;
        }
        return result;
    }

    private IEnumerable<CardSet> SetsWithKeywords
    {
        get
        {
            var used = Catalog.Keywords.SelectMany(k => k.Sets).ToHashSet();
            return State.AllSets.Where(s => used.Contains(s.Id)).OrderBy(s => s.Released).ThenBy(s => s.Name);
        }
    }

    private IEnumerable<Keyword> Filtered()
    {
        var q = _search.Trim();
        return Catalog.Keywords
            .Where(k => _setFilter.Length == 0 || k.Sets.Contains(_setFilter))
            .Where(k => q.Length == 0
                        || k.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                        || k.Summary.Contains(q, StringComparison.OrdinalIgnoreCase)
                        || k.Rules.Any(r => r.Contains(q, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(k => k.Name, StringComparer.OrdinalIgnoreCase);
    }

    private string SetName(string id) => _names.TryGetValue(id, out var n) ? n : id;
    private int SetOrder(string id) => _order.TryGetValue(id, out var i) ? i : int.MaxValue;
}
