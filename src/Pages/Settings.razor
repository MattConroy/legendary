@page "/settings"
@implements IDisposable
@inject GameStateService State

<PageTitle>Legendary — Sets & Options</PageTitle>

<div class="settings">
    <h1 class="page-title">Sets &amp; Options</h1>

    <section class="panel">
        <h2 class="panel__title">Default player count</h2>
        <div class="players__picker" role="group" aria-label="Default player count">
            @for (var n = 1; n <= 5; n++)
            {
                var count = n;
                <button class="chip @(State.Players == count ? "chip--active" : "")"
                        @onclick="() => State.SetPlayersAsync(count)"
                        aria-pressed="@(State.Players == count)">
                    @count
                </button>
            }
        </div>
    </section>

    <section class="panel">
        <div class="sets-head">
            <h2 class="panel__title">Content sets</h2>
            <div class="sort" role="group" aria-label="Sort sets">
                <span class="sort__label">Sort</span>
                <button class="sort__btn @(State.Sort == SetSort.Name ? "sort__btn--active" : "")"
                        @onclick="() => State.SetSortAsync(SetSort.Name)">
                    Name @(SortArrow(SetSort.Name))
                </button>
                <button class="sort__btn @(State.Sort == SetSort.Date ? "sort__btn--active" : "")"
                        @onclick="() => State.SetSortAsync(SetSort.Date)">
                    Date @(SortArrow(SetSort.Date))
                </button>
            </div>
        </div>

        <p class="muted small sets-hint">Mark what you <strong>own</strong> (auto-enables it), then toggle which sets are <strong>in play</strong> for this game — you can play a set you're borrowing without owning it.</p>
        <div class="sets-actions">
            <span class="sets-actions__label">Play:</span>
            <button class="linkbtn" @onclick="() => State.SetAllEnabledAsync(true)">All</button>
            <button class="linkbtn" @onclick="() => State.SetAllEnabledAsync(false)">None</button>
            <span class="sets-actions__sep">·</span>
            <button class="linkbtn" @onclick="() => State.SetOwnedEnabledAsync(true)">Owned</button>
            <button class="linkbtn" @onclick="() => State.SetOwnedEnabledAsync(false)">Not owned</button>
        </div>

        <div class="set-cols"><span>Set</span><span>Own</span><span>Play</span></div>
        <ul class="set-list">
            @foreach (var set in State.SortedSets)
            {
                var owned = State.IsOwned(set.Id);
                var enabled = State.IsEnabled(set.Id);
                <li class="set @(owned ? "" : "set--unowned")">
                    <div class="set__info">
                        <div class="set__name">
                            @set.Name
                            @if (set.Standalone)
                            {
                                <span class="pill pill--standalone" title="Can be played on its own">Standalone</span>
                            }
                        </div>
                        <span class="set__date">@set.Released.Year</span>
                    </div>

                    <label class="switch switch--sm" title="@(owned ? "Owned" : "Not owned")">
                        <input type="checkbox" checked="@owned" @onchange="e => Own(set.Id, e)" />
                        <span class="switch__track"><span class="switch__thumb"></span></span>
                    </label>

                    <label class="switch switch--sm" title="In play this game">
                        <input type="checkbox" checked="@enabled" @onchange="e => Play(set.Id, e)" />
                        <span class="switch__track"><span class="switch__thumb"></span></span>
                    </label>
                </li>
            }
        </ul>
    </section>

    <section class="panel">
        <p class="muted small">Unofficial fan app. <a href="about">Disclaimer &amp; setup reference →</a></p>
    </section>
</div>

@code {
    protected override void OnInitialized() => State.OnChange += StateChanged;

    protected override async Task OnInitializedAsync() => await State.InitializeAsync();

    private string SortArrow(SetSort key) =>
        State.Sort != key ? "" : State.SortDescending ? "↓" : "↑";

    private void Own(string id, ChangeEventArgs e) => _ = State.SetOwnedAsync(id, e.Value is true);
    private void Play(string id, ChangeEventArgs e) => _ = State.SetEnabledAsync(id, e.Value is true);

    private void StateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.OnChange -= StateChanged;
}
