@page "/settings"
@implements IDisposable
@inject GameStateService State

<PageTitle>Legendary — Sets & Options</PageTitle>

<div class="settings">
    <h1 class="page-title">Sets &amp; Options</h1>

    <section class="panel">
        <h2 class="panel__title">Default player count</h2>
        <PlayerCountPicker Selected="State.DefaultPlayers" OnSelect="n => State.SetDefaultPlayersAsync(n)" />
    </section>

    <section class="panel">
        <div class="sets-head">
            <h2 class="panel__title">Content sets</h2>
            <div class="sort" role="group" aria-label="Sort sets">
                <span class="sort__label">Sort</span>
                <button class="sort__button @(State.Sort == SetSort.Name ? "sort__button--active" : "")"
                        @onclick="() => State.SetSortAsync(SetSort.Name)">
                    Name @(SortArrow(SetSort.Name))
                </button>
                <button class="sort__button @(State.Sort == SetSort.Date ? "sort__button--active" : "")"
                        @onclick="() => State.SetSortAsync(SetSort.Date)">
                    Date @(SortArrow(SetSort.Date))
                </button>
            </div>
        </div>

        <p class="muted small sets-hint"><strong>Own</strong> marks your collection. <strong>Play</strong> picks which sets go into this game's shuffle.</p>
        <div class="sets-actions">
            <span class="sets-actions__label">Play:</span>
            <button class="link-button" @onclick="() => State.SetAllEnabledAsync(true)">All</button>
            <button class="link-button" @onclick="() => State.SetAllEnabledAsync(false)">None</button>
            <span class="sets-actions__sep">·</span>
            <button class="link-button" @onclick="() => State.SetOwnedEnabledAsync(true)">Owned</button>
            <button class="link-button" @onclick="() => State.SetOwnedEnabledAsync(false)">Not owned</button>
        </div>

        <div class="set-cols"><span>Set</span><span>Own</span><span>Play</span></div>
        <ul class="set-list">
            @foreach (var set in State.SortedSets)
            {
                var owned = State.IsOwned(set.Id);
                var enabled = State.IsEnabled(set.Id);
                var open = _expanded.Contains(set.Id);
                <li class="set @(owned ? "" : "set--unowned")">
                    <div class="set__row">
                        <button type="button" class="set__info set__toggle" @onclick="() => Toggle(set.Id)"
                                aria-expanded="@open" aria-label="@(open ? "Hide" : "Show") contents of @set.Name">
                            <span class="set__caret @(open ? "set__caret--open" : "")" aria-hidden="true">▸</span>
                            <span class="set__name">@set.Name</span>
                            <span class="set__date">@set.Released.Year</span>
                            @if (set.Standalone)
                            {
                                <span class="pill pill--standalone" title="Can be played on its own">Standalone</span>
                            }
                        </button>

                        <label class="switch switch--sm" title="@(owned ? "Owned" : "Not owned")">
                            <input type="checkbox" checked="@owned" @onchange="e => Own(set.Id, e)" />
                            <span class="switch__track"><span class="switch__thumb"></span></span>
                        </label>

                        <label class="switch switch--sm" title="In play this game">
                            <input type="checkbox" checked="@enabled" @onchange="e => Play(set.Id, e)" />
                            <span class="switch__track"><span class="switch__thumb"></span></span>
                        </label>
                    </div>

                    @if (open)
                    {
                        <div class="set__contents">
                            @if (set.Masterminds.Count > 0)
                            {
                                <ContentGroup Title="Masterminds" Count="set.Masterminds.Count">
                                    @foreach (var c in set.Masterminds) { <li class="tag">@c.Name</li> }
                                </ContentGroup>
                            }
                            @if (set.Schemes.Count > 0)
                            {
                                <ContentGroup Title="Schemes" Count="set.Schemes.Count">
                                    @foreach (var c in set.Schemes) { <li class="tag">@c.Name</li> }
                                </ContentGroup>
                            }
                            @if (set.VillainGroups.Count > 0)
                            {
                                <ContentGroup Title="Villain Groups" Count="set.VillainGroups.Count">
                                    @foreach (var c in set.VillainGroups) { <li class="tag">@c.Name</li> }
                                </ContentGroup>
                            }
                            @if (set.Henchmen.Count > 0)
                            {
                                <ContentGroup Title="Henchmen" Count="set.Henchmen.Count">
                                    @foreach (var c in set.Henchmen) { <li class="tag">@c.Name</li> }
                                </ContentGroup>
                            }
                            @if (set.Heroes.Count > 0)
                            {
                                <ContentGroup Title="Heroes" Count="set.Heroes.Count">
                                    @foreach (var c in set.Heroes)
                                    {
                                        <li class="tag tag--hero"><TeamIcon Team="@c.Team" />@c.Name</li>
                                    }
                                </ContentGroup>
                            }
                        </div>
                    }
                </li>
            }
        </ul>
    </section>

    <section class="panel">
        <p class="muted small">Unofficial fan app. <a href="about">Disclaimer &amp; setup reference →</a></p>
    </section>
</div>

@code {
    private readonly HashSet<string> _expanded = new();

    private void Toggle(string id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    protected override void OnInitialized() => State.OnChange += StateChanged;

    protected override async Task OnInitializedAsync() => await State.InitializeAsync();

    private string SortArrow(SetSort key) =>
        State.Sort != key ? "" : State.SortDescending ? "↓" : "↑";

    private void Own(string id, ChangeEventArgs e) => _ = State.SetOwnedAsync(id, e.Value is true);
    private void Play(string id, ChangeEventArgs e) => _ = State.SetEnabledAsync(id, e.Value is true);

    private void StateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.OnChange -= StateChanged;
}
