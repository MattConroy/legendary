@page "/settings"
@implements IDisposable
@inject GameStateService State

<PageTitle>Legendary — Sets & Options</PageTitle>

<div class="settings">
    <h1 class="page-title">Sets &amp; Options</h1>

    <section class="panel">
        <h2 class="panel__title">Default player count</h2>
        <PlayerCountPicker Selected="State.DefaultPlayers" OnSelect="n => State.SetDefaultPlayersAsync(n)" />
    </section>

    <section class="panel">
        <div class="sets-head">
            <h2 class="panel__title">Content sets</h2>
            <div class="sort" role="group" aria-label="Sort sets">
                <span class="label">Sort</span>
                <button class="@(State.Sort == SetSort.Name ? "active" : "")"
                        @onclick="() => State.SetSortAsync(SetSort.Name)">
                    Name @(SortArrow(SetSort.Name))
                </button>
                <button class="@(State.Sort == SetSort.Date ? "active" : "")"
                        @onclick="() => State.SetSortAsync(SetSort.Date)">
                    Date @(SortArrow(SetSort.Date))
                </button>
            </div>
        </div>

        <p class="muted small sets-hint"><strong>Own</strong> marks your collection. <strong>Play</strong> picks which sets go into this game's shuffle.</p>
        <div class="sets-actions">
            <span class="label">Play:</span>
            <button @onclick="() => State.SetAllEnabledAsync(true)">All</button>
            <button @onclick="() => State.SetAllEnabledAsync(false)">None</button>
            <span class="sep">·</span>
            <button @onclick="() => State.SetOwnedEnabledAsync(true)">Owned</button>
            <button @onclick="() => State.SetOwnedEnabledAsync(false)">Not owned</button>
        </div>

        <div class="set-cols"><span>Set</span><span>Own</span><span>Play</span></div>
        <ul class="set-list">
            @foreach (var set in State.SortedSets)
            {
                <SetRow Set="set" Owned="State.IsOwned(set.Id)" Enabled="State.IsEnabled(set.Id)"
                        Open="_expanded.Contains(set.Id)"
                        OnToggle="() => Toggle(set.Id)"
                        OnOwnChanged="owned => State.SetOwnedAsync(set.Id, owned)"
                        OnPlayChanged="enabled => State.SetEnabledAsync(set.Id, enabled)" />
            }
        </ul>
    </section>

    <section class="panel">
        <p class="muted small">Unofficial fan app. <a href="about">Disclaimer &amp; setup reference →</a></p>
    </section>
</div>

@code {
    private readonly HashSet<string> _expanded = new();

    private void Toggle(string id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    protected override void OnInitialized() => State.OnChange += StateChanged;

    protected override async Task OnInitializedAsync() => await State.InitializeAsync();

    private string SortArrow(SetSort key) =>
        State.Sort != key ? "" : State.SortDescending ? "↓" : "↑";

    private void StateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.OnChange -= StateChanged;
}
