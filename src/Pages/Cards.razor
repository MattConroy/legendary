@page "/cards"
@inject GameStateService State
@inject IKeywordRepository Keywords
@inject ICardDetailRepository CardDetails
@inject NavigationManager Nav

<PageTitle>Legendary — Cards</PageTitle>

<div class="cards-page">
    <h1 class="page-title">Cards</h1>
    <p class="muted small">Browse every card in the sets you own or borrow — heroes, masterminds, schemes, villains and henchmen. Card facts only; tap “view card” to see the real card on the Legendary wiki.</p>

    @if (State.AllSets.Count == 0)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        <div class="tabs" role="tablist" aria-label="Card type">
            @foreach (var (value, label) in Categories)
            {
                <button class="tab @(_category == value ? "tab--active" : "")" role="tab"
                        aria-selected="@(_category == value)" @onclick="() => SetCategory(value)">
                    @label
                </button>
            }
        </div>
        <FilterBar Search="_search" SearchChanged="SetSearch"
                   SetFilter="_setFilter" SetFilterChanged="SetSetFilter"
                   Sets="State.SortedSets.Select(s => (s.Id, s.Name))"
                   AllLabel="All sets" SearchPlaceholder="Search cards…"
                   SearchLabel="Search cards" FilterLabel="Filter by set" />

        var results = Filtered();
        <p class="muted small kw-count">@results.Count card@(results.Count == 1 ? "" : "s")</p>

        @if (results.Count == 0)
        {
            <p class="muted">No cards match.</p>
        }
        else
        {
            <ul class="cat-list">
                <Virtualize Items="results" Context="entry" OverscanCount="6">
                    @{
                        var card = entry.Card;
                        var team = (card as Hero)?.Team;
                        var band = (card as Mastermind)?.ThreatBand ?? (card as Scheme)?.ThreatBand;
                        var kws = Keywords.IsLoaded ? Keywords.InPlay(new[] { card.Id }) : [];
                        var deck = CardDetails.IsLoaded ? CardDetails.For(card.Id) : [];
                        var open = _expanded.Contains(card.Id);
                        var clickable = deck.Count > 0;
                        var headClass = clickable ? "cat__head is-clickable" : "cat__head";
                        string? roleAttr = clickable ? "button" : null;
                        string? tabAttr = clickable ? "0" : null;
                        bool? expandedAttr = clickable ? open : null;
                    }
                    <li class="cat @(open && deck.Count > 0 ? "cat--open" : "")">
                        <div class="@headClass" role="@roleAttr" tabindex="@tabAttr" aria-expanded="@expandedAttr"
                             @onclick="() => TryToggle(card.Id, deck.Count)"
                             @onkeydown="e => OnHeadKey(e, card.Id, deck.Count)">
                            @if (deck.Count > 0)
                            {
                                <span class="cat__caret @(open ? "cat__caret--open" : "")" aria-hidden="true">▸</span>
                            }
                            <div class="cat__main">
                                @if (card is Hero)
                                {
                                    <TeamIcon Team="@team" />
                                }
                                <span class="cat__name">@card.Name</span>
                                <span class="cat__set">@entry.SetName</span>
                                @if (band is { } b)
                                {
                                    <ThreatPill Band="b" />
                                }
                            </div>
                        </div>
                        @if (open && deck.Count > 0)
                        {
                            <ul class="deck">
                                @foreach (var d in deck)
                                {
                                    <li class="deck__card">
                                        <div class="deck__row">
                                            <span class="deck__cls">
                                                @foreach (var cls in d.Classes)
                                                {
                                                    <img src="classes/@(cls.ToLowerInvariant()).png" alt="@cls" title="@cls" />
                                                }
                                            </span>
                                            <span class="deck__copies">@d.Copies×</span>
                                            <span class="deck__name">@d.Name</span>
                                            @if (d.Kind is not null && d.Value is not null)
                                            {
                                                <span class="stat stat--@d.Kind" title="@ValText(d) @Resource(d.Kind)">
                                                    <img class="stat__icon" src="classes/@(d.Kind).svg" alt="@Resource(d.Kind)" />
                                                    <span class="stat__num">@ValText(d)</span>
                                                </span>
                                            }
                                            @if (d.Cost is { } cost)
                                            {
                                                <span class="cost" title="Cost @cost">
                                                    <img class="cost__icon" src="classes/cost.svg" alt="Cost" />
                                                    <span class="cost__num">@cost</span>
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(d.Effect))
                                        {
                                            <p class="deck__effect">@EffectHtml(d.Effect)</p>
                                        }
                                        @if (d.Keywords.Count > 0)
                                        {
                                            <ul class="tag-list deck__kws">
                                                @foreach (var kw in d.Keywords)
                                                {
                                                    <li><a class="tag" href="keywords?q=@Uri.EscapeDataString(KwBase(kw))">@kw</a></li>
                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        @if (kws.Count > 0)
                        {
                            <ul class="tag-list cat__kws">
                                @foreach (var k in kws)
                                {
                                    <li><a class="tag" href="keywords?q=@Uri.EscapeDataString(k.Name)" title="@k.Summary">@k.Name</a></li>
                                }
                            </ul>
                        }
                    </li>
                </Virtualize>
            </ul>
        }
    }
</div>

@code {
    private string _search = string.Empty;
    private string _category = nameof(CardCategory.Hero);
    private string _setFilter = string.Empty;

    private List<Entry> _all = [];
    private readonly HashSet<string> _expanded = [];

    private static readonly (string Value, string Label)[] Categories =
    {
        (nameof(CardCategory.Hero), "Heroes"),
        (nameof(CardCategory.Mastermind), "Masterminds"),
        (nameof(CardCategory.Scheme), "Schemes"),
        (nameof(CardCategory.VillainGroup), "Villain Groups"),
        (nameof(CardCategory.Henchmen), "Henchmen"),
    };

    protected override async Task OnInitializedAsync()
    {
        await State.InitializeAsync();
        // Keywords are secondary — never let them break browsing.
        try { await Keywords.EnsureLoadedAsync(); } catch { /* chips just won't show */ }
        try { await CardDetails.EnsureLoadedAsync(); } catch { /* breakdowns just won't show */ }

        _all = State.AllSets
            .SelectMany(set => set.AllCards.Select(c => new Entry(c, set.Name, set.Id)))
            .ToList();

        // Restore filter state from the URL so leaving and coming back keeps your place.
        var q = ParseQuery(Nav.Uri);
        if (q.TryGetValue("cat", out var cat) && Enum.TryParse<CardCategory>(cat, out _)) _category = cat;
        if (q.TryGetValue("set", out var set)) _setFilter = set;
        if (q.TryGetValue("q", out var search)) _search = search;
    }

    private void SetCategory(string value) { _category = value; SyncUrl(); }
    private void SetSearch(string value) { _search = value; SyncUrl(); }
    private void SetSetFilter(string value) { _setFilter = value; SyncUrl(); }

    // Mirror the current filters into the URL (replacing history, so typing doesn't
    // spam the back stack) so the state survives navigating away and back.
    private void SyncUrl()
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["cat"] = _category == nameof(CardCategory.Hero) ? null : _category,
            ["set"] = string.IsNullOrEmpty(_setFilter) ? null : _setFilter,
            ["q"] = string.IsNullOrEmpty(_search) ? null : _search,
        });
        Nav.NavigateTo(uri, forceLoad: false, replace: true);
    }

    private static Dictionary<string, string> ParseQuery(string uri)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var i = uri.IndexOf('?');
        if (i < 0) return result;
        foreach (var pair in uri[(i + 1)..].Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split('=', 2);
            result[Uri.UnescapeDataString(kv[0])] = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : string.Empty;
        }
        return result;
    }

    // A card's keyword token can carry a value (e.g. "Focus 3"); link to the base
    // keyword ("Focus") so the glossary search finds it.
    private static string KwBase(string keyword) =>
        System.Text.RegularExpressions.Regex.Replace(keyword, @"\s+\d+$", "");

    private List<Entry> Filtered()
    {
        var q = _search.Trim();
        IEnumerable<Entry> items = _all;

        if (Enum.TryParse<CardCategory>(_category, out var cat))
            items = items.Where(e => e.Card.Category == cat);
        if (_setFilter.Length > 0)
            items = items.Where(e => e.SetId == _setFilter);
        if (q.Length > 0)
            items = items.Where(e => e.Card.Name.Contains(q, StringComparison.OrdinalIgnoreCase));

        return items
            .OrderBy(e => e.Card.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void Toggle(string id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    private void TryToggle(string id, int deckCount)
    {
        if (deckCount > 0) Toggle(id);
    }

    private void OnHeadKey(KeyboardEventArgs e, string id, int deckCount)
    {
        if (deckCount > 0 && e.Key is "Enter" or " ") Toggle(id);
    }

    private static string Resource(string kind) => kind == "recruit" ? "Recruit" : "Attack";

    // Effect notes carry explicit {slug} tokens for icons (e.g. "{avengers}", "+3 {attack}").
    // Only those tokens are swapped for icons; signed numbers are bolded.
    private static readonly System.Text.RegularExpressions.Regex TokenRe = new(@"\{([a-z0-9-]+)\}");
    private static readonly System.Text.RegularExpressions.Regex NumRe = new(@"([+\-]\d+)");
    private static readonly HashSet<string> ResourceSlugs = new() { "attack", "recruit", "cost" };
    private static readonly HashSet<string> ClassSlugs = new() { "covert", "instinct", "ranged", "strength", "tech" };

    private static MarkupString EffectHtml(string s)
    {
        var html = new System.Text.StringBuilder();
        var last = 0;
        foreach (System.Text.RegularExpressions.Match m in TokenRe.Matches(s))
        {
            if (m.Index > last) html.Append(Boldify(s[last..m.Index]));
            var slug = m.Groups[1].Value;
            var src = ResourceSlugs.Contains(slug) ? $"classes/{slug}.svg"
                : ClassSlugs.Contains(slug) ? $"classes/{slug}.png"
                : $"teams/{slug}.png";
            html.Append($"<img class=\"ic\" src=\"{src}\" alt=\"{slug}\" />");
            last = m.Index + m.Length;
        }
        if (last < s.Length) html.Append(Boldify(s[last..]));
        return new MarkupString(html.ToString());
    }

    // Encode text, bold signed numbers (+4, -2) so bonuses stand out, and turn
    // the card's own line breaks (\n) into <br> so multi-effect cards read line
    // by line just like the printed card.
    private static string Boldify(string t) =>
        NumRe.Replace(System.Net.WebUtility.HtmlEncode(t), "<strong>$1</strong>")
             .Replace("\n", "<br>");

    private static string ValText(CardDetail d) => $"{d.Value}{(d.Variable ? "+" : "")}";

    private readonly record struct Entry(GameCard Card, string SetName, string SetId);
}
