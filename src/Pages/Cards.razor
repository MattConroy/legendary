@page "/cards"
@inject GameStateService State
@inject IKeywordRepository Keywords
@inject ICardDetailRepository CardDetails
@inject NavigationManager Nav

<PageTitle>Legendary — Cards</PageTitle>

<div class="cards-page">
    <h1 class="page-title">Cards</h1>
    <p class="muted small">Browse every card in the sets you own or borrow — heroes, masterminds, schemes, villains and henchmen. Card facts only; tap “view card” to see the real card on the Legendary wiki.</p>

    @if (State.AllSets.Count == 0)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        <div class="tabs" role="tablist" aria-label="Card type">
            @foreach (var (value, label) in Categories)
            {
                <button class="@(_category == value ? "active" : "")" role="tab"
                        aria-selected="@(_category == value)" @onclick="() => SetCategory(value)">
                    @label
                </button>
            }
        </div>
        <FilterBar Search="@_search" SearchChanged="SetSearch"
                   SetFilter="@_setFilter" SetFilterChanged="SetSetFilter"
                   Sets="State.SortedSets.Select(s => (s.Id, s.Name))"
                   AllLabel="All sets" SearchPlaceholder="Search cards…"
                   SearchLabel="Search cards" FilterLabel="Filter by set" />

        var results = Filtered();
        <p class="muted small result-count">@results.Count card@(results.Count == 1 ? "" : "s")</p>

        @if (results.Count == 0)
        {
            <p class="muted">No cards match.</p>
        }
        else
        {
            <ul class="list">
                <Virtualize Items="results" Context="entry" OverscanCount="6">
                    @{
                        var card = entry.Card;
                        var deck = CardDetails.IsLoaded ? CardDetails.For(card.Id) : [];
                        var keywords = Keywords.IsLoaded ? Keywords.InPlay(new[] { card.Id }) : [];
                    }
                    <CardEntry Card="card" SetName="@entry.SetName" Deck="deck" Kws="keywords"
                               Open="_expanded.Contains(card.Id)"
                               OnToggle="() => Toggle(card.Id)" />
                </Virtualize>
            </ul>
        }
    }
</div>

@code {
    private string _search = string.Empty;
    private string _category = nameof(CardCategory.Hero);
    private string _setFilter = string.Empty;

    private List<Entry> _all = [];
    private readonly HashSet<string> _expanded = [];

    private static readonly (string Value, string Label)[] Categories =
    {
        (nameof(CardCategory.Hero), "Heroes"),
        (nameof(CardCategory.Mastermind), "Masterminds"),
        (nameof(CardCategory.Scheme), "Schemes"),
        (nameof(CardCategory.VillainGroup), "Villain Groups"),
        (nameof(CardCategory.Henchmen), "Henchmen"),
    };

    protected override async Task OnInitializedAsync()
    {
        await State.InitializeAsync();
        // Keywords are secondary — never let them break browsing.
        try { await Keywords.EnsureLoadedAsync(); } catch { /* chips just won't show */ }
        try { await CardDetails.EnsureLoadedAsync(); } catch { /* breakdowns just won't show */ }

        _all = State.AllSets
            .SelectMany(set => set.AllCards.Select(c => new Entry(c, set.Name, set.Id)))
            .ToList();

        // Restore filter state from the URL so leaving and coming back keeps your place.
        var query = ParseQuery(Nav.Uri);
        if (query.TryGetValue("category", out var category) && Enum.TryParse<CardCategory>(category, out _)) _category = category;
        if (query.TryGetValue("set", out var set)) _setFilter = set;
        if (query.TryGetValue("search", out var search)) _search = search;
    }

    private void SetCategory(string value) { _category = value; SyncUrl(); }
    private void SetSearch(string value) { _search = value; SyncUrl(); }
    private void SetSetFilter(string value) { _setFilter = value; SyncUrl(); }

    // Mirror the current filters into the URL (replacing history, so typing doesn't
    // spam the back stack) so the state survives navigating away and back.
    private void SyncUrl()
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["category"] = _category == nameof(CardCategory.Hero) ? null : _category,
            ["set"] = string.IsNullOrEmpty(_setFilter) ? null : _setFilter,
            ["search"] = string.IsNullOrEmpty(_search) ? null : _search,
        });
        Nav.NavigateTo(uri, forceLoad: false, replace: true);
    }

    private static Dictionary<string, string> ParseQuery(string uri)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var i = uri.IndexOf('?');
        if (i < 0) return result;
        foreach (var pair in uri[(i + 1)..].Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split('=', 2);
            result[Uri.UnescapeDataString(kv[0])] = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : string.Empty;
        }
        return result;
    }

    private List<Entry> Filtered()
    {
        var q = _search.Trim();
        IEnumerable<Entry> items = _all;

        if (Enum.TryParse<CardCategory>(_category, out var parsed))
            items = items.Where(e => e.Card.Category == parsed);
        if (_setFilter.Length > 0)
            items = items.Where(e => e.SetId == _setFilter);
        if (q.Length > 0)
            items = items.Where(e => e.Card.Name.Contains(q, StringComparison.OrdinalIgnoreCase));

        return items
            .OrderBy(e => e.Card.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void Toggle(string id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    private readonly record struct Entry(GameCard Card, string SetName, string SetId);
}
