@page "/about"

<PageTitle>Legendary — About</PageTitle>

<div class="about">
    <h1 class="page-title">About</h1>

    <Panel Title="Unofficial fan app" Disclaimer="true">
        <p>
            An unofficial, fan-made setup helper for <em>Legendary: A Marvel Deck Building Game</em>.
            Not affiliated with or endorsed by Marvel or the game's publishers. All names are
            trademarks of their respective owners. You need the physical game to play.
        </p>
    </Panel>

    <Panel Title="Setup reference">
        <div class="table-wrap">
            <table class="rules">
                <thead>
                    <tr><th>Players</th><th>Heroes</th><th>Villains</th><th>Henchmen</th><th>Strikes</th><th>Bystanders</th><th>Twists</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in SetupTable.ByPlayers.Values.OrderBy(r => r.Players))
                    {
                        <tr>
                            <td>@r.Players</td>
                            <td>@r.Heroes</td>
                            <td>@r.VillainGroups</td>
                            <td>@r.Henchmen</td>
                            <td>@r.MasterStrikes</td>
                            <td>@r.Bystanders</td>
                            <td>@r.SchemeTwists</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted small">Schemes can change these — each result shows its actual counts, and the
            Mastermind's required group carries a <Badge>Required</Badge> badge.</p>
    </Panel>

    <p class="version muted small">Legendary Companion · PWA · works offline once loaded.</p>
</div>
