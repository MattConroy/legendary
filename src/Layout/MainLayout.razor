@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="app-shell">
    <header class="app-header">
        <div class="app-header__inner">
            <span class="app-header__logo">LEGENDARY</span>
            <span class="app-header__sub">Setup Randomiser</span>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>

    <nav class="app-nav">
        <NavLink class="app-nav__item" href="" Match="NavLinkMatch.All">
            <span class="app-nav__icon">🎲</span>
            <span class="app-nav__label">Setup</span>
        </NavLink>
        <NavLink class="app-nav__item" href="settings">
            <span class="app-nav__icon">⚙️</span>
            <span class="app-nav__label">Sets</span>
        </NavLink>
        <NavLink class="app-nav__item" href="cards">
            <span class="app-nav__icon">🃏</span>
            <span class="app-nav__label">Cards</span>
        </NavLink>
        <NavLink class="app-nav__item" href="keywords">
            <span class="app-nav__icon">📖</span>
            <span class="app-nav__label">Keywords</span>
        </NavLink>
        <NavLink class="app-nav__item" href="about">
            <span class="app-nav__icon">ℹ️</span>
            <span class="app-nav__label">About</span>
        </NavLink>
    </nav>
</div>

@code {
    private string? _lastPath;

    protected override void OnInitialized()
    {
        _lastPath = PathOf(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    // Reset the content scroll on a real page change, but not when a page only
    // rewrites its own query string (e.g. the Cards filters syncing to the URL),
    // so filtering doesn't yank you back to the top.
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = PathOf(e.Location);
        if (path == _lastPath) return;
        _lastPath = path;
        await JS.InvokeVoidAsync("scrollMainToTop");
    }

    private static string PathOf(string uri) => new Uri(uri, UriKind.Absolute).AbsolutePath;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
